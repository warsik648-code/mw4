---
import '../../styles/product-cheat-page.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { productHub, productPages } from '../../data/products';
import { cheatTierIcons, productCategoryIcons } from '../../data/sectionIcons';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../utils/schema';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CatalogCard from '../../components/CatalogCard.astro';
import { productPath } from '../../utils/path';
import type { IconName } from '../../components/icons/types';

const seo = resolvePageSeo('/store/');
const breadcrumbs = [
  { name: t.ui.home, path: '/' },
  { name: 'Store', path: productHub.path },
];

function cardIcon(product: (typeof productPages)[number]): IconName {
  if (product.kind === 'tier') return cheatTierIcons[product.name] ?? 'crosshair';
  return productCategoryIcons[product.category ?? ''] ?? 'package';
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: 'Store',
      description: seo.description,
      url: productHub.path,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(productPages.map((product) => ({ name: product.title, url: productPath(product.slug) }))),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6 max-w-3xl space-y-3">
        <h1 class="text-3xl font-bold uppercase md:text-4xl">Store</h1>
        <h2 class="text-lg font-semibold normal-case">Store: Call of Duty 4: Modern Warfare Cheats</h2>
        <p class="text-lg text-muted-foreground">{t.products.subtitle} This store lists the three cards with their own checkout links.</p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {productPages.map((product) => (
          <CatalogCard
            class={product.slug === 'modern-warfare-cheats' ? 'ring-2 ring-primary' : undefined}
            label={product.tier ?? product.category ?? product.name}
            title={product.title}
            href={productPath(product.slug)}
            buyUrl={product.buyUrl}
            features={product.features}
            more={product.more}
            icon={cardIcon(product)}
            badge={product.badge}
            variant={product.variant}
            imageSrc={product.cardImage?.src}
            imageAlt={product.cardImage?.alt}
            buyLabel={`Buy ${product.name}`}
            viewLabel={`View ${product.name}`}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
