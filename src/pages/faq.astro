---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllFaqs } from '../data/faq';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';
import SectionHeader from '../components/SectionHeader.astro';

const seo = resolvePageSeo('/faq/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq/' },
];

const faqs = getAllFaqs();
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: seo.title,
      description: seo.description,
      url: '/faq/',
    }),
    faqPageSchema(faqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') }))),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6">
        <SectionHeader
          eyebrow="Help center"
          title="Plans features"
          desc="These plans features explain monthly and lifetime access, Windows PC requirements, and related-product checkout."
          titleId="faq-page-title"
          level="h1"
        />
      </div>
      <h2 class="mt-6 text-lg font-semibold">Plans Features: Call of Duty 4: Modern Warfare Cheats</h2>
      <p class="mt-3 max-w-3xl text-muted-foreground">The plans features below match the prices and feature names on the store cards.</p>
    </div>
  </section>

  <SiteFaqSection items={faqs} variant="full" titleId="faq-page-list" />
</BaseLayout>
