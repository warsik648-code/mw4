---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { t } from '../i18n';
import { ROUTES } from '../utils/path';

const seo = resolvePageSeo('/status/');
const breadcrumbs = [
  { name: t.ui.home, path: '/' },
  { name: 'Status', path: '/status/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[webPageSchema({ name: seo.title, description: seo.description, url: '/status/' }), breadcrumbSchema(breadcrumbs)]}
>
  <article class="py-8 md:py-12">
    <div class="mx-auto max-w-3xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="mt-6 text-3xl font-bold md:text-4xl">Call of Duty 4: Modern Warfare status</h1>
      <h2 class="mt-4 text-lg font-semibold">Status: Call of Duty 4: Modern Warfare Cheats</h2>
      <div class="mt-6 space-y-4 text-muted-foreground">
        <p>This page is the compatibility note for Call of Duty 4: Modern Warfare Cheats. It is not a live Call of Duty 4: Modern Warfare server status board, and it does not publish a player count.</p>
        <p>There is no current notice on this site that marks the product undetected, safe, or compatible with a specific game build. After a Call of Duty 4: Modern Warfare update, treat the last build as unverified until a new note is published here.</p>
        <p>Easy Anti-Cheat (EAC) is the anti-cheat name used for compatibility questions about this listing. Public material for the original 2007 PC release also refers to PunkBuster. This page does not claim that either system is bypassed.</p>
        <p>The status here is a written compatibility record, not a dashboard that refreshes on its own. If this status page has no newer note, that means the last build is unverified. It does not mean the product was tested against the newest client, and it does not mean a restriction is impossible.</p>
        <p>Read the status before you treat a guide, a screenshot, or an old checkout note as current. A game update can change whether the listed features still match the client you launch. The status page is the place that limit is written down. Other pages can name the features. They do not replace this status.</p>
        <p>Game server status, Steam charts, and tracker sites answer a different question. Use those sources for population and server questions. Do not treat a number on another site as a figure published by mw4cheats.net.</p>
        <p>Related reading: <a class="text-primary" href="/patch-notes/">patch notes</a>, <a class="text-primary" href="/player-count/">player count</a>, <a class="text-primary" href="/easy-anti-cheat/">Easy Anti-Cheat</a>, and the <a class="text-primary" href={ROUTES.mainProduct}>main product</a>.</p>
      </div>
    </div>
  </article>
</BaseLayout>
